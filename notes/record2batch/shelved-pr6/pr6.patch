+    def rollout_training(self, batch: str, training_reports: Mapping[str, tuple[str, ...]]) -> None:
+        store = self.require_store()
+        for use in store.uses(batch=batch):
+            if use.use_id in training_reports:
+                store.update_use(replace(use, state="training", training_report_ids=training_reports[use.use_id]))
+
+    def rollout_ended(self, outcome: RolloutBatchOutcome) -> None:
+        store = self.require_store()
+        for use in store.uses(batch=outcome.batch):
+            if use.state not in ACTIVE_USE_STATES:
+                continue
+            if use.use_id not in outcome.training_reports:
+                store.update_use(replace(use, state="untrainable"))
+            elif outcome.trained:
+                store.update_use(replace(use, state="trained"))
+            else:
+                store.update_use(replace(use, state="stale_rejected"))
+        self.return_tasks(store.uses(batch=outcome.batch))
+
+    def recover(
+        self, outcomes: tuple[RolloutBatchOutcome, ...], consumed_ids: frozenset[str]
+    ) -> RecoveredRollout | None:
+        """Settle the uses that a restart interrupted, from the outcomes that commits and stale receipts recorded.
+
+        A use that a commit names trained, and one that a stale receipt names was dropped. A use of such a batch
+        that the outcome does not name could not train. A use that was still playing is cancelled. A batch whose
+        plays ended, and whose reports no commit consumed, re-forms from the replayed reports.
+        """
+        if not self.is_rolling_out or self.record2task is None or self.record2task.task_store is None:
+            return None
+        store = self.record2task.task_store
+        # A commit is the stronger record: a batch it names trained, whatever else names the batch.
+        ended: dict[str, RolloutBatchOutcome] = {}
+        for recorded in outcomes:
+            if recorded.batch not in ended or recorded.trained:
+                ended[recorded.batch] = recorded
+        active = tuple(use for use in store.uses() if use.state in ACTIVE_USE_STATES)
+        for use in active:
+            if (
+                use.batch not in ended
+                and use.state != "running"
+                and consumed_ids.intersection(use.training_report_ids)
+            ):
+                raise TaskStoreError(
+                    f"task use {use.use_id} of rollout {use.batch} trained on reports that a commit consumed, "
+                    "but no commit or stale receipt records the batch; check the commit log before restarting"
+                )
+        settled: list[TaskUse] = []
+        rolled_out: list[TaskUse] = []
+        for use in active:
+            outcome = ended.get(use.batch)
+            if outcome is not None:
+                report_ids = outcome.training_reports.get(use.use_id)
+                if report_ids is None:
+                    state: UseState = "untrainable"
+                elif outcome.trained:
+                    state = "trained"
+                else:
+                    state = "stale_rejected"
+                store.update_use(replace(use, state=state))
+                settled.append(use)
+            elif use.state == "running":
+                store.update_use(replace(use, state="cancelled"))
+                settled.append(use)
+            else:
+                rolled_out.append(use)
+        batches = {use.batch for use in rolled_out}
+        # One rollout runs at a time, so at most one batch can re-form.
+        resumed = next(iter(batches)) if len(batches) == 1 else None
+        if len(batches) > 1:
+            logger.warning(
+                "scenario %r cancels rollouts %s: only one rollout re-forms", self.scenario, sorted(batches)
+            )
+        for use in rolled_out:
+            if use.batch != resumed:
+                store.update_use(replace(use, state="cancelled"))
+                settled.append(use)
+        self.return_tasks(tuple(settled))
+        if resumed is None:
+            return None
+        resumed_uses = tuple(use for use in store.uses(batch=resumed) if use.state in ACTIVE_USE_STATES)
+        return RecoveredRollout(
+            batch=resumed,
+            task_uses=tuple(use.use_id for use in resumed_uses),
+            reported_plays={use.use_id: use.reported_plays or 0 for use in resumed_uses},
+        )
+
+    def return_tasks(self, uses: tuple[TaskUse, ...]) -> None:
+        """Put the tasks of ended uses that may roll out again back in the task pool; a retired task gets a result.
+
+        The generator's feedback waits for a result of every train task, so a task retired before any play
+        records an infrastructure failure.
+        """
+        store = self.require_store()
+        available = {saved.generated.task.name: saved for saved in store.available_tasks()}
+        for use in uses:
+            saved = available.get(use.task_name)
+            if saved is not None:
+                self.require_record2record().add_tasks((task_item(saved),), group_key=saved.generation)
+        # Every retired task is checked, so a stop inside an earlier return leaves no task without its result.
+        for saved in store.tasks(split="train"):
+            name = saved.generated.task.name
+            if store.is_retired(task_name=name) and not store.has_result(task_name=name):
+                store.record_result(
+                    generation=saved.generation,
+                    result=PlayedResult(task_name=name, error="retired before a play", infrastructure_failure=True),
+                )
+        self.require_record2task().deliver_later()
+
+    def require_store(self) -> FileTaskStore:
+        store = self.require_record2task().task_store
+        if store is None:
+            raise RuntimeError("a rollout needs the record-to-task stage's task store")
+        return store
+
+    def require_record2task(self) -> GeneratedTaskTasks:
+        if self.record2task is None:
+            raise RuntimeError("a rollout needs the generated-task record-to-task stage")
+        return self.record2task
+
+    def require_record2record(self) -> GeneratedTaskRecord2Record:
+        if self.record2record is None:
+            raise RuntimeError("a rollout needs the generated-task record stage")
+        return self.record2record
 
     def running(self) -> bool:
         return self.running_batch is not None
